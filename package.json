    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-react-x": "^2.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
