    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "qs": "^6.14.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-router": "^7.12.0",
    "react-select": "^5.10.2",
    "rxdb": "^16.21.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.5.0",
    "uuidv7": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/forms": "^0.5.11",
